<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="10dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_power" android:layout_width="62dp" android:layout_height="62dp"
        android:gravity="center" android:text="⚡" android:textColor="#A3E635"
        android:textSize="32sp" android:textStyle="bold" android:background="@drawable/widget_power_background"
        android:contentDescription="Toggle flashlight" />
    <LinearLayout android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="14dp" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ANB FLASHLIGHT" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="TORCH OFF" android:textColor="#27BFFF"
            android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="Tap power to toggle • Tap here to open"
            android:textColor="#B7C6D8" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
